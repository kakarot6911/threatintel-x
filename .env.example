# Copy to .env and fill in. Every secret is read from the environment only (prefix TIX_).

# --- core ----------------------------------------------------------------
TIX_API_KEY=change-me-to-a-long-random-string   # required for the API/UI (python -c "import secrets;print(secrets.token_urlsafe(32))")
# TIX_DATABASE_URL=postgresql+psycopg://tix:tix@localhost:5432/threatintel   # default: SQLite under data/
TIX_LOG_LEVEL=INFO
TIX_LOG_JSON=true

# --- safety switches (defaults are the safe choice) -------------------------
TIX_ONLINE=false                     # allow outbound network (enrichment, feeds, integrations)
TIX_ALLOW_PRIVATE_DESTINATIONS=false # SSRF guard: only enable for a lab MISP/OpenCTI/TAXII on a private network
TIX_ACTIVE_DNS=false                 # resolving suspicious domains queries attacker name servers - opt in
# TIX_REDACTION_KEY=                 # optional HMAC key: correlate identical leaked secrets without storing them

# --- organisation profile (relevance scoring); lists are JSON ---------------
TIX_ORG_NAME="Example Technology Corp (synthetic)"
TIX_ORG_DOMAINS=["examplecorp.example"]
TIX_ORG_SECTORS=["technology"]
TIX_ORG_REGIONS=["south-asia","north-america"]

# --- enrichment providers (optional) ---------------------------------------
TIX_VT_API_KEY=
TIX_URLSCAN_API_KEY=
TIX_ABUSEIPDB_API_KEY=
TIX_SHODAN_API_KEY=
TIX_CENSYS_API_ID=
TIX_CENSYS_API_SECRET=

# --- sharing platforms (optional) ------------------------------------------
TIX_MISP_URL=
TIX_MISP_KEY=
TIX_MISP_VERIFY_TLS=true
TIX_OPENCTI_URL=
TIX_OPENCTI_TOKEN=
TIX_TAXII_SERVER=
TIX_TAXII_USERNAME=
TIX_TAXII_PASSWORD=

# --- Telegram: authorised bot only, allow-listed chat ids (JSON list) --------
TIX_TELEGRAM_BOT_TOKEN=
TIX_TELEGRAM_ALLOWED_CHATS=[]
